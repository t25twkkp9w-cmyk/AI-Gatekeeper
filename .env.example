# Synthetic local demo is the default. No key required.
GATEKEEPER_MODE=demo
# Set live to enable an OpenAI-generated review narrative.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Enable only with synthetic data and your own project.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-gatekeeper-healthcare
